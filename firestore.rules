rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // Entity validation blueprints (Anti-Update-Gap)
    function isValidNote(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'content', 'category', 'colorKey', 'pinned', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'title', 'content', 'category', 'colorKey', 'pinned', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() <= 120 &&
             data.content is string && data.content.size() <= 10000 &&
             (data.title.size() > 0 || data.content.size() > 0) &&
             data.category is string && data.category in ['personal', 'work', 'ideas', 'study', 'other'] &&
             data.colorKey is string && data.colorKey in ['default', 'sand', 'sage', 'terracotta', 'slate', 'ochre'] &&
             data.pinned is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTaskList(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'colorKey', 'iconKey', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'name', 'colorKey', 'iconKey', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.colorKey is string && data.colorKey in ['terracotta', 'sage', 'ochre', 'slate', 'sand'] &&
             data.iconKey is string && data.iconKey in ['checklist', 'work', 'shopping', 'home', 'star'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTask(data, userId) {
      return data.keys().hasAll(['userId', 'listId', 'title', 'details', 'completed', 'priority', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'listId', 'title', 'details', 'completed', 'priority', 'dueDateEpochDay', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == userId &&
             isValidId(data.listId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.details is string && data.details.size() <= 2000 &&
             data.completed is bool &&
             data.priority is string && data.priority in ['low', 'medium', 'high'] &&
             (!('dueDateEpochDay' in data) || data.dueDateEpochDay == null || (data.dueDateEpochDay is int && data.dueDateEpochDay >= 0 && data.dueDateEpochDay <= 100000)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 1. User Notes Collection
    match /users/{userId}/notes/{noteId} {
      allow get: if isOwner(userId) && isValidId(noteId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(noteId) &&
                       isValidNote(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(noteId) &&
                       isValidNote(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action: Toggle pin
                         incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
                         // Action: Edit note fields
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'colorKey', 'pinned', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(noteId);
    }

    // 2. User Task Lists Collection
    match /users/{userId}/taskLists/{listId} {
      allow get: if isOwner(userId) && isValidId(listId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(listId) &&
                       isValidTaskList(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(listId) &&
                       isValidTaskList(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       // Action: Rename or restyle list
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'colorKey', 'iconKey', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(listId);
    }

    // 3. User Tasks Collection
    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(taskId);
      allow list: if isOwner(userId);

      // Pillar 10 evaluation order: Auth -> Static Validation -> Relational exists() check
      allow create: if isOwner(userId) &&
                       isValidId(taskId) &&
                       isValidTask(incoming(), userId) &&
                       exists(/databases/$(database)/documents/users/$(userId)/taskLists/$(incoming().listId));

      allow update: if isOwner(userId) &&
                       isValidId(taskId) &&
                       isValidTask(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action: Toggle completion
                         incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
                         // Action: Edit task fields (with parent list existence check if moved)
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['listId', 'title', 'details', 'completed', 'priority', 'dueDateEpochDay', 'updatedAt']) &&
                           (incoming().listId == existing().listId || exists(/databases/$(database)/documents/users/$(userId)/taskLists/$(incoming().listId)))
                         )
                       );

      allow delete: if isOwner(userId) && isValidId(taskId);
    }
  }
}
